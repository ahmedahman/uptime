generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DayType {
  LIFT
  REST
  CARDIO
}

model Exercise {
  id           String                 @id @default(cuid())
  name         String
  muscleGroup  String
  notes        String?
  sets         WorkoutSet[]
  workoutLogs  WorkoutLog[]
  dayExercises DayTemplateExercise[]
}

model DayTemplate {
  id        String                 @id @default(cuid())
  dayOfWeek Int                    @unique
  dayName   String
  type      DayType
  skillName String?
  exercises DayTemplateExercise[]
}

model DayTemplateExercise {
  id            String      @id @default(cuid())
  dayTemplateId String
  dayTemplate   DayTemplate @relation(fields: [dayTemplateId], references: [id])
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id])
  order         Int
  scheme        String

  @@index([dayTemplateId])
}

model WorkoutLog {
  id         String       @id @default(cuid())
  date       String
  dayOfWeek  Int
  exerciseId String
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])
  sets       WorkoutSet[]
  createdAt  DateTime     @default(now())

  @@unique([exerciseId, date])
  @@index([exerciseId, date])
}

model WorkoutSet {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  setIndex     Int
  weightKg     Float?
  reps         Int?
  isPr         Boolean    @default(false)

  @@index([exerciseId])
}

model SkillLog {
  id          String   @id @default(cuid())
  date        String
  skillName   String
  holdSeconds Int?
  attempts    Int?
  notes       String?
  createdAt   DateTime @default(now())
}

model CoreLog {
  id           String   @id @default(cuid())
  date         String
  exerciseName String
  sets         Int?
  reps         Int?
  durationSec  Int?
  createdAt    DateTime @default(now())
}

model CardioLog {
  id              String   @id @default(cuid())
  date            String
  activityType    String
  durationMinutes Int
  notes           String?
  createdAt       DateTime @default(now())
}

model WarmupLog {
  id        String   @id @default(cuid())
  date      String   @unique
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BodyweightLog {
  id        String   @id @default(cuid())
  date      String   @unique
  weightKg  Float
  createdAt DateTime @default(now())
}

model UserStats {
  id           String   @id @default("singleton")
  weightKg     Float    @default(61)
  heightCm     Float    @default(170)
  age          Int      @default(25)
  activityMult Float    @default(1.2)
  proteinPerKg Float    @default(1.8)
  surplusPct   Float    @default(0.15)
  updatedAt    DateTime @updatedAt
}
